        release: { id: "1", name: `v${phaseIndex + 1}.${i + 1}` },
      });
    }
  });

  // Create markers for phase transitions
  const markers = [
    {
      id: "1",
      date: phase1Start.toISOString(),
      label: "Project Kickoff",
      className: "bg-blue-100 text-blue-900",
    },
    {
