        setAnalysis(jobAnalysis);
        setError(null);
      } catch (error) {
        console.error("Error analyzing job:", error);
        setError(error instanceof Error ? error.message : "Failed to analyze job");
      } finally {
        setLoading(false);
      }
    }

    loadAndAnalyzeJob();
  }, [jobId]);

