        if (!scene || !camera) return;
        
        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();
        
        // Convert to normalized device coordinates
        mouse.x = (x / window.innerWidth) * 2 - 1;
        mouse.y = -(y / window.innerHeight) * 2 + 1;
        
        raycaster.setFromCamera(mouse, camera);
        const intersects = raycaster.intersectObjects(scene.children, true);
        
        console.log('Raycaster intersections:', intersects.length);
        console.log('First 3 intersections:', intersects.slice(0, 3));
      };
      
      return oldRender.call(this, scene, camera);
    };
    
    console.log('Diagnostics prepared. You can now click in the scene and then run checkRaycast(x, y) with the click coordinates.');
  };
  document.head.appendChild(script);
}`;
        
        output.innerHTML += "<code>" + diagCode + "</code>\n\n";
        output.innerHTML += "4. Click on a point in the visualization\n";
        output.innerHTML += "5. Run <code>checkRaycast(mouseX, mouseY)</code> with the click coordinates\n";
        output.innerHTML += "6. Check if any objects are being intersected\n\n";
        
        const infoDiv = document.createElement('div');
        infoDiv.className = 'infoBox';
        infoDiv.innerHTML = "If no intersections are found, the points might not be properly set up for raycasting. If intersections are found but no selection happens, there's an issue with the state update.";
        output.appendChild(infoDiv);
      } catch (err) {
        output.innerHTML += "Error: " + err.message;
      }
    }
    
    function applyFix() {
      const output = document.getElementById('fixOutput');
      output.innerHTML = "Preparing fix...\n";
      
      try {
        output.innerHTML += "Cannot directly modify other tabs due to browser security.\n\n";
        output.innerHTML += "MANUAL FIX STEPS:\n";
        output.innerHTML += "1. Go back to the code editor\n";
        output.innerHTML += "2. Replace the Points component in monte-carlo/scene/points.tsx with this code:\n\n";
        
        const fixCode = `"use client";

import React, { useRef, useEffect } from 'react';
import { useThree } from '@react-three/fiber';
import * as THREE from 'three';
import type { PointWithCluster } from '@/lib/monte-carlo-service';
import { findClosestPoints, SELECTION_COLOR, CLUSTER_SELECTION_COLOR } from '../utils';

interface PointsProps {
  data: PointWithCluster[];
  hoveredPoint: PointWithCluster | null;
  setHoveredPoint: (point: PointWithCluster | null) => void;
  setClosestPoints: (points: PointWithCluster[]) => void;
  selectedPoint: PointWithCluster | null;
  setSelectedPoint: (point: PointWithCluster | null) => void;
  selectedClusters: number[];
  isCameraMovingRef: React.RefObject<boolean>;
  filteredData: PointWithCluster[]; 
}

// Brighter colors for better visibility
const BRIGHT_COLORS = {
  "gpt-4": "#3b82f6",    // blue-500
  "claude": "#8b5cf6",   // violet-500
  "o1": "#22c55e",       // green-500
  "o3": "#f59e0b",       // amber-500
  "other": "#64748b",    // slate-500
};

export function Points({
  data,
  hoveredPoint,
  setHoveredPoint,
  setClosestPoints,
  selectedPoint,
  setSelectedPoint,
  selectedClusters,
  isCameraMovingRef,
  filteredData,
}: PointsProps) {
  // Simple array with one sphere per point
  const points = useRef<THREE.Object3D[]>([]);
  const group = useRef<THREE.Group>(null);
  const { raycaster, mouse, camera, gl, scene } = useThree();
  
  // Main click handler function
  const handlePointClicked = (point: PointWithCluster) => {
    if (!filteredData.some(p => p.id === point.id)) return;
    
    console.log("CLICK DETECTED on point:", point.id, point.model);
    
    // Visual debug feedback
    const debug = new THREE.Mesh(
      new THREE.SphereGeometry(0.2, 16, 16),
      new THREE.MeshBasicMaterial({ color: 0xff0000, wireframe: true })
    );
    debug.position.set(point.position[0], point.position[1], point.position[2]);
    scene.add(debug);
    
    // Clean up debug visual after 2 seconds
    setTimeout(() => scene.remove(debug), 2000);
    
    // Toggle selection
    if (selectedPoint && selectedPoint.id === point.id) {
      console.log("DESELECTING point:", point.id);
      setSelectedPoint(null);
    } else {
      console.log("SELECTING point:", point.id);
      setSelectedPoint(point);
    }
  };
  
  // Handle canvas click to detect point clicks
  useEffect(() => {
    // Skip if no group or no data
    if (!gl || !camera || data.length === 0) return;
    
    // Get the canvas element
    const canvas = gl.domElement;
    
    // Define click handler
    const handleCanvasClick = (event: MouseEvent) => {
      // Skip if camera is moving
      if (isCameraMovingRef.current) return;
      
      // Get click position in normalized device coordinates (-1 to +1)
      const rect = canvas.getBoundingClientRect();
      const mouseX = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      const mouseY = -((event.clientY - rect.top) / rect.height) * 2 + 1;
      
      // Set up raycaster
      const tempRaycaster = new THREE.Raycaster();
      tempRaycaster.setFromCamera(new THREE.Vector2(mouseX, mouseY), camera);
      
      // Look for the first point that's intersected
      if (group.current) {
        const intersects = tempRaycaster.intersectObjects(group.current.children, true);
        
        if (intersects.length > 0) {
          // Find the data point from the object's userData
          let currentObj = intersects[0].object;
          while (currentObj && !currentObj.userData?.pointId) {
            currentObj = currentObj.parent;
          }
          
          if (currentObj && currentObj.userData?.pointId) {
            const pointId = currentObj.userData.pointId;
            const point = data.find(p => p.id === pointId);
            
            if (point) {
              // Alert for debugging
              console.log("Intersected point:", pointId);
              
              // Handle the click
              handlePointClicked(point);
            }
          }
        }
      }
    };
    
    // Add event listener
    canvas.addEventListener('click', handleCanvasClick, false);
    
    // Cleanup
    return () => {
      canvas.removeEventListener('click', handleCanvasClick);
    };
  }, [gl, camera, data, selectedPoint, filteredData, isCameraMovingRef, setSelectedPoint]);
  
  // Helper function to get point color
  const getPointColor = (point: PointWithCluster): string => {
    // Selected point
    if (selectedPoint && point.id === selectedPoint.id) {
      return SELECTION_COLOR;
    }
    
    // Points closest to selected point
    if (selectedPoint) {
      const closest = findClosestPoints(selectedPoint, data, 4);
      if (closest.some(p => p.id === point.id)) {
        return SELECTION_COLOR;
      }
    }
    
    // Hovered point
    if (hoveredPoint && point.id === hoveredPoint.id) {
      return SELECTION_COLOR;
    }
    
    // Points closest to hovered point
    if (hoveredPoint) {
      const closest = findClosestPoints(hoveredPoint, data, 4);
      if (closest.some(p => p.id === point.id)) {
        return SELECTION_COLOR;
      }
    }
    
    // Points in selected cluster
    if (selectedClusters.length > 0 && selectedClusters.includes(point.cluster ?? -1)) {
      return CLUSTER_SELECTION_COLOR;
    }
    
    // Default color based on model
    const modelLower = point.model.toLowerCase().trim();
    if (modelLower.includes("gpt-4") || modelLower.includes("gpt4") || modelLower.includes("gpt-4o")) {
      return BRIGHT_COLORS["gpt-4"];
    }
    if (modelLower.includes("claude-sonnet") || modelLower.includes("claude")) {
      return BRIGHT_COLORS.claude;
    }
    if (modelLower.includes("o1")) {
      return BRIGHT_COLORS.o1;
    }
    if (modelLower.includes("o3-mini") || modelLower.includes("o3")) {
      return BRIGHT_COLORS.o3;
    }
    return BRIGHT_COLORS.other;
  };
  
  // Point scaling based on state
  const getPointScale = (point: PointWithCluster): number => {
    if (selectedPoint && point.id === selectedPoint.id) {
      return 1.2; // Selected points are larger
    }
    if (hoveredPoint && point.id === hoveredPoint.id) {
      return 1.1; // Hovered points are slightly larger
    }
    return 1; // Default scale
  };

  // Super simple implementation with direct meshes
  return (
    <group ref={group}>
      {data.map((point, i) => (
        <mesh
          key={point.id}
          position={[point.position[0], point.position[1], point.position[2]]}
          scale={[getPointScale(point), getPointScale(point), getPointScale(point)]}
          userData={{ pointId: point.id, pointIndex: i }}
          onClick={(e) => {
            e.stopPropagation();
            // This may not work directly, but we'll try both approaches
            handlePointClicked(point);
          }}
        >
          <sphereGeometry args={[0.10, 24, 24]} />
          <meshBasicMaterial color={getPointColor(point)} toneMapped={false} />
        </mesh>
      ))}
    </group>
  );
}`;
        
        output.innerHTML += "<code>" + fixCode + "</code>\n\n";
        output.innerHTML += "3. Add this code to visualizer-canvas.tsx just before the Canvas component to fix the issue:\n\n";
        
        const canvasFixCode = `// Add this before the Canvas component
useEffect(() => {
  // Create global callback for debugging
  window.__handleMonteCarloPointSelection = (pointId) => {
    const point = data.find(p => p.id === pointId);
    if (point) {
      console.log("External selection of point:", pointId);
      setSelectedPoint(point);
      return true;
    }
    return false;
  };
  
  return () => {
    delete window.__handleMonteCarloPointSelection;
  };
}, [data, setSelectedPoint]);`;
        
        output.innerHTML += "<code>" + canvasFixCode + "</code>\n\n";
        
        const successDiv = document.createElement('div');
        successDiv.className = 'successBox';
        successDiv.innerHTML = "After applying these changes, the selection should work properly. If you still have issues, try the fallback approach by adding a direct DOM click listener from the browser console.";
        output.appendChild(successDiv);
      } catch (err) {
        output.innerHTML += "Error: " + err.message;
      }
    }
    
    // Add event listeners to buttons
    document.getElementById('diagEvents').addEventListener('click', diagnoseEventHandling);
    document.getElementById('diagThree').addEventListener('click', diagnoseThreeJsScene);
    document.getElementById('applyFix').addEventListener('click', applyFix);
  </script>
</body>
</html>
</file>

