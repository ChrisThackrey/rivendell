    "Python": "Python for Data Science",
    "AWS": "AWS Certified Solutions Architect",
    "Docker": "Docker and Kubernetes Essentials"
  };

  return skillGaps
    .map(skill => recommendationMap[skill] || \`Training for \${skill}\`)
    .filter(Boolean);
}`
