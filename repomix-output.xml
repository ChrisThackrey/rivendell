    // We should see "(1)" for Claude count (1 item)
    expect(screen.getByText(/Claude \(1\)/)).toBeInTheDocument();
    
    // We should see "(1)" for o1 count (1 item)
    expect(screen.getByText(/o1 \(1\)/)).toBeInTheDocument();
  });
});
