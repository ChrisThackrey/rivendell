    const { error } = await supabase
      .from("documents")
      .delete()
      .eq("batch_id", batch_id)
      .not("metadata->>stepNumber", "is", null);

    if (error) {
      captureException(error, {
        context: "Error deleting steps by batch ID",
        batchId: batch_id,
      });
      return false;
    }

    return true;
  } catch (error) {
    captureException(error, {
      context: "Error in deleteStepsByBatchId",
      batchId: batch_id,
    });
    return false;
  }
}

